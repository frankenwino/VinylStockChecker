# Discord Webhook Configuration
# Get your webhook URL from Discord:
# 1. Go to your Discord server settings
# 2. Navigate to Integrations > Webhooks
# 3. Create a new webhook or copy an existing one
# 4. Copy the webhook URL and paste it below
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Example:
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789012345678/abcdefghijklmnopqrstuvwxyz1234567890

# Discord Bot Token (required for bulk-deleting channel messages)
# Found in Discord Developer Portal → Your App → Bot → Reset Token
DISCORD_BOT_TOKEN=your_bot_token_here
